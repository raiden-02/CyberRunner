# Client build-time vars (Vite). Copy to .env.local for local overrides.

# WebSocket URL. Unset uses the page host.
# VITE_WS_URL=ws://localhost:2567

# Google Identity Services client ID. Guest play works if this is unset.
# Also accepted: a meta[name="google-client-id"] tag in index.html.
# VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
