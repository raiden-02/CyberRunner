# Local server only. Loaded by dotenv from this directory.
# Droplet uses /opt/CyberRunner/server.env via systemd. See DEPLOY.md.

NODE_ENV=production
HOST=0.0.0.0
PORT=2567
MAX_PLAYERS=8

DATABASE_URL=postgres://cyberrunner:localdev@127.0.0.1:5432/cyberrunner
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
# Must match the client build (VITE_GOOGLE_CLIENT_ID or the google-client-id meta tag).
SESSION_SECRET=replace_with_a_long_random_string
SESSION_COOKIE_NAME=cr_session
APP_ORIGIN=http://localhost:4173

# ArenaForge (optional). Never commit a real key.
OPENAI_API_KEY=
# Default if unset: gpt-5.6
ARENA_FORGE_MODEL=
# Live designer in Forge. Off unless exactly true AND a key exists.
# Do not enable this on a public internet-facing host unless you intend to pay for inference.
ARENA_FORGE_LIVE_AGENT_ENABLED=
