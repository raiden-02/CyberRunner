# Local server. Loaded by dotenv from this directory.
# Production uses /opt/CyberRunner/server.env. See DEPLOY.md.

# --- Game ---
NODE_ENV=development
HOST=0.0.0.0
PORT=2567
MAX_PLAYERS=8

# --- Optional auth / database ---
# Guest play works if these are unset.
DATABASE_URL=postgres://cyberrunner:localdev@127.0.0.1:5432/cyberrunner
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
SESSION_SECRET=replace_with_a_long_random_string
SESSION_COOKIE_NAME=cr_session
APP_ORIGIN=http://localhost:4173

# --- Optional live ArenaForge (server-only) ---
# Never put keys in client/.env or browser JS. Recorded demo works with this block unset.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ARENA_FORGE_PROVIDER=openai
# ARENA_FORGE_MODEL=
# ARENA_FORGE_LIVE_AGENT_ENABLED=true
# ARENA_FORGE_ACCESS_MODE=self_host
# ARENA_FORGE_USER_DAILY_LIMIT=1
# ARENA_FORGE_GLOBAL_DAILY_LIMIT=10
