# Local server only. Loaded by dotenv from this directory.
# Droplet uses /opt/CyberRunner/server.env via systemd. See DEPLOY.md.

# Local bind. Production behind Caddy must use HOST=127.0.0.1 (see DEPLOY.md).
# If HOST is unset, NODE_ENV=production defaults to 127.0.0.1.
NODE_ENV=development
HOST=0.0.0.0
PORT=2567
MAX_PLAYERS=8

DATABASE_URL=postgres://cyberrunner:localdev@127.0.0.1:5432/cyberrunner
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
# Must match the client build (VITE_GOOGLE_CLIENT_ID or the google-client-id meta tag).
SESSION_SECRET=replace_with_a_long_random_string
SESSION_COOKIE_NAME=cr_session
APP_ORIGIN=http://localhost:4173

# ArenaForge (optional). Never commit a real key. Never put a key in browser JS.
OPENAI_API_KEY=
# Default if unset: gpt-5.6
ARENA_FORGE_MODEL=
# Live designer. Off unless exactly true AND a server-side key exists.
# Public recorded demo works with this unset.
ARENA_FORGE_LIVE_AGENT_ENABLED=
# hosted = authenticated + quota-backed public deployment
# self_host = trusted private/local server using its own server-side key
# Default is hosted. Missing DB or NODE_ENV does not switch you to self_host.
ARENA_FORGE_ACCESS_MODE=hosted
# Quota limits apply to hosted mode only. Defaults: 1 per user / 10 global per UTC day.
ARENA_FORGE_USER_DAILY_LIMIT=1
ARENA_FORGE_GLOBAL_DAILY_LIMIT=10
